<Window x:Class="RevitFlux.Plugin.UI.AutoModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitFlux — Auto mode"
        Width="430" SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="ToolWindow"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource PageBackground}"
        Loaded="Window_Loaded">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{DynamicResource Glyph}" FontSize="22" VerticalAlignment="Top"
                   Margin="0,2,14,0" Foreground="{DynamicResource WarningText}"/>
        <StackPanel>
            <TextBlock Text="Auto mode is on" Style="{DynamicResource Strong}" FontSize="16"/>
            <TextBlock Text="Destructive operations are approved automatically, without confirmation dialogs."
                       Style="{DynamicResource Caption}" FontSize="13" Margin="0,4,0,12"/>
            <Button x:Name="StopButton" Content="Stop Auto" Style="{DynamicResource AccentButton}"
                    HorizontalAlignment="Left" Click="Stop_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
