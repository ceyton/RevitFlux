<Window x:Class="RevitFlux.Plugin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitFlux" Width="860" Height="580" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource PageBackground}" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="{DynamicResource NavBackground}">
            <DockPanel x:Name="NavPanel" Width="208">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,20,12,16">
                    <Image x:Name="BrandImage" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="BrandText" Text="RevitFlux" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectedIndex="0"
                         ItemContainerStyle="{DynamicResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sections"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- Inline message -->
            <Border x:Name="MessageBar" DockPanel.Dock="Bottom" CornerRadius="8" Padding="14,10" Margin="24,0,24,16" Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MessageGlyph" Style="{DynamicResource Glyph}"/>
                    <TextBlock x:Name="MessageText" Style="{DynamicResource Body}" Margin="10,0,0,0" MaxWidth="560"/>
                </StackPanel>
            </Border>

            <Grid>
                <!-- Home -->
                <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="Home" Style="{DynamicResource Title}"/>
                        <Border Style="{DynamicResource Card}" Padding="20">
                            <StackPanel>
                                <Border x:Name="StatusPill" HorizontalAlignment="Left" CornerRadius="12" Padding="10,4" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="StatusGlyph" Style="{DynamicResource Glyph}" FontSize="12"/>
                                        <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="StatusDetail" Style="{DynamicResource Caption}" FontSize="14" Margin="0,4,0,16"/>
                                <Button x:Name="ToggleButton" Style="{DynamicResource AccentButton}" HorizontalAlignment="Left" Click="Toggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ToggleGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ToggleText" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="Safety" Style="{DynamicResource Strong}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="SafetySummary" Style="{DynamicResource Body}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBox x:Name="PortBox" Width="84" MaxLength="5" AutomationProperties.Name="Port"
                                             TextChanged="Port_TextChanged" KeyDown="Port_KeyDown"/>
                                    <Button x:Name="PortApply" Content="Apply" Margin="8,0,0,0" Click="PortApply_Click" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Port" Style="{DynamicResource Body}"/>
                                    <TextBlock Text="Takes effect after Revit and your AI app restart. Default 8090." Style="{DynamicResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Safety -->
                <ScrollViewer x:Name="SafetyView" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="Safety" Style="{DynamicResource Title}"/>
                        <Border Style="{DynamicResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="ReadOnlySwitch" DockPanel.Dock="Right" Margin="16,0,0,0" Style="{DynamicResource Switch}"
                                          AutomationProperties.Name="Read-only mode" Click="ReadOnly_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Read-only mode" Style="{DynamicResource Body}"/>
                                    <TextBlock Text="The AI can look at the model but not change it." Style="{DynamicResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="ScriptsSwitch" DockPanel.Dock="Right" Margin="16,0,0,0" Style="{DynamicResource Switch}"
                                              AutomationProperties.Name="Allow scripts" Click="Scripts_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Allow scripts" Style="{DynamicResource Body}"/>
                                        <TextBlock Text="Lets the AI run its own C# when no tool fits. Off by default." Style="{DynamicResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14"/>
                                <DockPanel>
                                    <CheckBox x:Name="SkipSwitch" DockPanel.Dock="Right" Margin="16,0,0,0" Style="{DynamicResource Switch}"
                                              AutomationProperties.Name="Run scripts without asking me" Click="Skip_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Run scripts without asking me" Style="{DynamicResource Body}"/>
                                        <TextBlock Text="Scripts start immediately and can change or delete anything in the open model."
                                                   Style="{DynamicResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="SkipWarning" CornerRadius="4" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed"
                                        Background="{DynamicResource WarningBackground}">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" Style="{DynamicResource Glyph}" Foreground="{DynamicResource WarningText}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Confirmation is off. Work on a copy of the model." Style="{DynamicResource Body}"
                                                   FontSize="13" Foreground="{DynamicResource WarningText}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tools -->
                <DockPanel x:Name="ToolsView" Margin="24,20,24,16" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="Tools" Style="{DynamicResource Title}" Margin="0,0,0,12"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="AllOnButton" DockPanel.Dock="Right" Content="Turn all on" Margin="8,0,0,0" Click="AllOn_Click"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="34,6,10,6" TextChanged="Search_TextChanged" AutomationProperties.Name="Search tools"/>
                            <TextBlock Text="&#xE721;" Style="{DynamicResource Glyph}" FontSize="14" Margin="12,0,0,0" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="SearchHint" Text="Search tools" Margin="36,0,0,0" VerticalAlignment="Center" FontSize="14"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                    </DockPanel>
                    <TextBlock x:Name="ToolCount" DockPanel.Dock="Bottom" Style="{DynamicResource Caption}" Margin="4,8,0,0"/>
                    <Border Style="{DynamicResource Card}" Padding="0" Margin="0">
                        <Grid>
                            <ListBox x:Name="ToolList" Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{DynamicResource PlainItem}" AutomationProperties.Name="Tools"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     KeyboardNavigation.TabNavigation="Continue"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{DynamicResource Strong}" FontSize="13" Margin="21,14,16,4"
                                                           Foreground="{DynamicResource Accent}"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="16,8">
                                            <CheckBox DockPanel.Dock="Right" Margin="16,0,0,0" Style="{DynamicResource Switch}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{DynamicResource Body}"/>
                                                <TextBlock Text="{Binding Description}" Style="{DynamicResource Caption}"
                                                           MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoTools" Style="{DynamicResource Body}" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- About -->
                <ScrollViewer x:Name="AboutView" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="About" Style="{DynamicResource Title}"/>
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="VersionText" Style="{DynamicResource Strong}"/>
                                <TextBlock x:Name="RevitText" Style="{DynamicResource Caption}"/>
                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14"/>
                                <TextBlock Text="Based on RevitCortex by Luigi Dattilo (MIT)" Style="{DynamicResource Body}"/>
                                <TextBlock Text="RevitFlux is independent and not affiliated with its author." Style="{DynamicResource Caption}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
