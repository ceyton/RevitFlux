<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug R23;Debug R24;Debug R25;Debug R26;Debug R27;Release R23;Release R24;Release R25;Release R26;Release R27</Configurations>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>RevitFlux.Plugin</RootNamespace>
    <AssemblyName>RevitFlux.Plugin</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <!-- Revit 2023 -->
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2024 -->
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2025 -->
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2026 -->
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2027 -->
  <PropertyGroup Condition="$(Configuration.Contains('R27'))">
    <RevitVersion>2027</RevitVersion>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER;REVIT2027_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Build 2024 against the installed API level (2024.3.40): newer references make Revit report a version conflict. -->
  <PropertyGroup>
    <RevitApiVersion>$(RevitVersion).*</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2024'">2024.3.40</RevitApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" />
  </ItemGroup>

  <!-- Roslyn Scripting for send_code_to_revit (net8+ only) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <!-- Roslyn pulls System.Collections.Immutable / System.Reflection.Metadata 8.0, which
       are framework-provided. The build/publish pipeline strips runtime-pack assemblies
       from the output, and Revit's shared AssemblyLoadContext won't probe our folder for
       them, so send_code_to_revit's Roslyn compiler fails to bind. We vendor the exact 8.0
       copies (runtime-deps\) and copy them into the output AFTER Build and AFTER Publish
       (so the publish trimming can't remove them); RevitFluxApp's AssemblyResolve handler
       then serves them past the shared ALC. net8 only (R25/R26). -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8'))">
    <VendoredRoslynDep Include="$(MSBuildProjectDirectory)\runtime-deps\*.dll" />
  </ItemGroup>
  <Target Name="CopyVendoredRoslynDepsAfterBuild" AfterTargets="Build" Condition="$(TargetFramework.StartsWith('net8'))">
    <Copy SourceFiles="@(VendoredRoslynDep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>
  <Target Name="CopyVendoredRoslynDepsAfterPublish" AfterTargets="Publish" Condition="$(TargetFramework.StartsWith('net8'))">
    <Copy SourceFiles="@(VendoredRoslynDep)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

  <!-- ZipArchive + HttpClient live in separate assemblies on net48 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitFlux.Core\RevitFlux.Core.csproj" />
  </ItemGroup>
  <!-- With the 4.8 targeting pack but not 4.8.1, MSBuild can add an mscorlib reference from the
       missing 4.8.1 folder, which breaks WPF markup compilation. Resolve it from 4.8 instead. -->
  <Target Name="FixMissingMscorlib" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' == 'net48'">
    <ItemGroup>
      <_MissingMscorlib Include="@(_ExplicitReference)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <ItemGroup Condition="'@(_MissingMscorlib)' != ''">
      <_ExplicitReference Remove="@(_MissingMscorlib)" />
      <Reference Include="mscorlib" />
    </ItemGroup>
  </Target>
</Project>
